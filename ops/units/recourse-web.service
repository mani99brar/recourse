# Recourse web: serves the built apps/web and forwards /api to the status API.
# Written to ~/.config/systemd/user by ops/units/install.sh, which fills in @NODE@ and @REPO@.
[Unit]
Description=Recourse web: static files for apps/web and the /api forward
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@REPO@/ops/units
# Public through the web tunnel, and it needs only its port, the status API's port and the dist folder,
# so it reads no shared env file (no keyed URL, key path or API key reaches it). Override in web.env.
EnvironmentFile=-%h/.config/recourse/web.env
Environment=WEB_PORT=8788
Environment=STATUS_API_PORT=8787
Environment=WEB_DIST_DIR=@REPO@/apps/web/dist
Environment=NODE_OPTIONS=--max-old-space-size=32
UnsetEnvironment=SSH_AUTH_SOCK
ExecStart=@NODE@ web-server.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
MemoryMax=48M
# Under host memory pressure the kernel kills user units (default oom_score_adj 200) before interactive
# sessions (0). 100 is the lowest a user unit can ask for: the user manager runs at 100, and a lower value
# is raised to 100 without a warning (tested with systemd-run --user on 6 Nov).
OOMScoreAdjust=100
NoNewPrivileges=true

[Install]
WantedBy=default.target
