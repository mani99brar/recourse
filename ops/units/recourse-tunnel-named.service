# Recourse named tunnel: fixed public hostnames for the web app (127.0.0.1:8788) and the shop (127.0.0.1:8720)
# on a Cloudflare account, in place of the two quick tunnels whose names change on every restart.
# ops/tunnel/setup.sh writes both files this unit reads; ops/tunnel/README.md has the operator's steps.
#   ~/.config/recourse/cloudflared.yml    ingress (cert option) or no ingress (token option: the dashboard holds it).
#                                         Not ~/.cloudflared/config.yml: cloudflared reads that file by default, and
#                                         the quick tunnels refuse to start beside a config with ingress rules.
#   ~/.config/recourse/cloudflared.token  the tunnel token, mode 600, read with --token-file so it is never on a
#                                         command line or in the environment.
# ops/tunnel/run.sh checks them (ExecStartPre, which fails with what is missing) and then execs cloudflared, by
# default with the token. RECOURSE_TUNNEL_AUTH=credentials in the optional ~/.config/recourse/tunnel.env runs it
# with the credentials file cloudflared.yml names instead (cert option only: the fallback when the token does not
# pick up the config's ingress).
# Written to ~/.config/systemd/user by ops/units/install.sh, which fills in @REPO@. Started only when named:
# ctl.sh start tunnel-named.
[Unit]
Description=Recourse tunnel: fixed public hostnames for the web app and the shop (named Cloudflare tunnel)
After=recourse-web.service recourse-shop.service
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=GOMEMLIMIT=64MiB
Environment=RECOURSE_TUNNEL_AUTH=token
# tunnel.env holds only the switch above. cloudflared would also take a token from TUNNEL_TOKEN or
# TUNNEL_TOKEN_FILE (a token wins over the credentials file) and credentials from TUNNEL_CRED_CONTENTS;
# UnsetEnvironment is applied after the file, so none of them can reach it from there.
EnvironmentFile=-%h/.config/recourse/tunnel.env
UnsetEnvironment=SSH_AUTH_SOCK TUNNEL_TOKEN TUNNEL_TOKEN_FILE TUNNEL_CRED_CONTENTS
ExecStartPre=/bin/bash @REPO@/ops/tunnel/run.sh --check
ExecStart=/bin/bash @REPO@/ops/tunnel/run.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
MemoryMax=96M
# Under host memory pressure the kernel kills user units (default oom_score_adj 200) before interactive
# sessions (0). 100 is the lowest a user unit can ask for: the user manager runs at 100, and a lower value
# is raised to 100 without a warning (tested with systemd-run --user on 6 Nov).
OOMScoreAdjust=100
NoNewPrivileges=true

[Install]
WantedBy=default.target
