# Recourse pre-check: records the rule-based answer on each filed claim.
# Written to ~/.config/systemd/user by ops/units/install.sh, which fills in @NODE@ and @REPO@.
[Unit]
Description=Recourse pre-check: records the rule-based answer on each filed claim
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@REPO@/services/precheck
EnvironmentFile=%h/.config/recourse/recourse.env
EnvironmentFile=-%h/.config/recourse/precheck.env
Environment=PRECHECK_PORT=8705
Environment=PRECHECK_STATE_DIR=%h/.local/state/recourse/precheck
# By default V8's young generation can grow to 128 MB on top of the old space, whatever --max-old-space-size says
# (a churn test at 32, 112 and 144 on 6 Nov); with --max-semi-space-size=4 it stayed under 12 MB. Replaying the
# largest topic-index journal the caps allow peaked at 225 MB RSS with --max-old-space-size=144 alone, above
# MemoryMax, and at 129 MB with both flags. Quoted, so systemd keeps both flags in the one value.
Environment="NODE_OPTIONS=--max-old-space-size=144 --max-semi-space-size=4"
# Key paths, secrets and keyed URLs this service never reads. UnsetEnvironment is applied after every
# EnvironmentFile, so <service>.env cannot bring them back; edit this list if the code starts using one.
UnsetEnvironment=KEYSTORE_DIR DEPLOYER_KEY_FILE OPS_HEDERA_KEY_FILE OPS_ARB_KEY_FILE PLATFORM_KEY_FILE AGENT_KEY_FILE SHOP_KEY_FILE SCHEME_KEY_FILE BUYER_KEY_FILE FACILITATOR_KEY_FILE
UnsetEnvironment=ARKIV_ACCESS_KEY LLM_API_KEY ARB_RPC_URL ARKIV_RPC_URL SSH_AUTH_SOCK
ExecStartPre=/usr/bin/mkdir -p %h/.local/state/recourse/precheck
ExecStart=@NODE@ --import tsx src/main.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
MemoryMax=192M
# Under host memory pressure the kernel kills user units (default oom_score_adj 200) before interactive
# sessions (0). 100 is the lowest a user unit can ask for: the user manager runs at 100, and a lower value
# is raised to 100 without a warning (tested with systemd-run --user on 6 Nov).
OOMScoreAdjust=100
NoNewPrivileges=true

[Install]
WantedBy=default.target
