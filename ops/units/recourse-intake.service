# Recourse intake: tags public feedback text.
# Written to ~/.config/systemd/user by ops/units/install.sh, which fills in @NODE@ and @REPO@.
[Unit]
Description=Recourse intake: tags public feedback text
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@REPO@/services/intake
EnvironmentFile=%h/.config/recourse/recourse.env
EnvironmentFile=-%h/.config/recourse/intake.env
Environment=INTAKE_PORT=8716
Environment=INTAKE_STATE_DIR=%h/.local/state/recourse/intake
Environment=NODE_OPTIONS=--max-old-space-size=112
# Key paths, secrets and keyed URLs this service never reads. UnsetEnvironment is applied after every
# EnvironmentFile, so <service>.env cannot bring them back; edit this list if the code starts using one.
UnsetEnvironment=KEYSTORE_DIR DEPLOYER_KEY_FILE OPS_HEDERA_KEY_FILE OPS_ARB_KEY_FILE PRECHECK_SIGNER_KEY_FILE PLATFORM_KEY_FILE AGENT_KEY_FILE SHOP_KEY_FILE SCHEME_KEY_FILE BUYER_KEY_FILE FACILITATOR_KEY_FILE
UnsetEnvironment=ARKIV_ACCESS_KEY ALERT_URL HEDERA_RPC_URL_1 HEDERA_RPC_URL_2 ARB_RPC_URL ARKIV_RPC_URL SSH_AUTH_SOCK
ExecStartPre=/usr/bin/mkdir -p %h/.local/state/recourse/intake
ExecStart=@NODE@ --import tsx src/main.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
MemoryMax=160M
# Under host memory pressure the kernel kills user units (default oom_score_adj 200) before interactive
# sessions (0). 100 is the lowest a user unit can ask for: the user manager runs at 100, and a lower value
# is raised to 100 without a warning (tested with systemd-run --user on 6 Nov).
OOMScoreAdjust=100
NoNewPrivileges=true

[Install]
WantedBy=default.target
