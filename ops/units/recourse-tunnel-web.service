# Recourse public tunnel for the web app (and its /api forward to the status API).
# A Cloudflare quick tunnel: no account, a random https://<words>.trycloudflare.com name that changes
# whenever this unit restarts. `ctl.sh urls` prints the current name.
# Written to ~/.config/systemd/user by ops/units/install.sh.
[Unit]
Description=Recourse tunnel: public HTTPS for the web app on 127.0.0.1:8788
After=recourse-web.service
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=GOMEMLIMIT=64MiB
UnsetEnvironment=SSH_AUTH_SOCK
ExecStart=%h/.local/bin/cloudflared tunnel --no-autoupdate --metrics 127.0.0.1:8789 --url http://127.0.0.1:8788
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
MemoryMax=96M
# Under host memory pressure the kernel kills user units (default oom_score_adj 200) before interactive
# sessions (0). 100 is the lowest a user unit can ask for: the user manager runs at 100, and a lower value
# is raised to 100 without a warning (tested with systemd-run --user on 6 Nov).
OOMScoreAdjust=100
NoNewPrivileges=true

[Install]
WantedBy=default.target
