# Recourse environment. Copy to .env and fill in; .env is never committed.
# Key variables hold paths to Foundry v3 keystores (<role>.json); the password is read from the
# file next to it (<role>.json.pass). Never put a key or a password in this file.

# --- chains and data sources ---
HEDERA_RPC_URL_1=
HEDERA_RPC_URL_2=
HEDERA_MIRROR_URL=
ARB_RPC_URL=
ARKIV_RPC_URL=
ARKIV_ACCESS_KEY=
X402_FACILITATOR_URLS=
IPFS_PIN_API_URL=
IPFS_PIN_API_KEY=
IPFS_PIN_API_SECRET=
IPFS_PIN_BUCKET=
IPFS_GATEWAY_URL=
LLM_API_KEY=
LLM_MODEL=
HCS_RECORDS_TOPIC_ID=
ALERT_URL=
SOURCIFY_VERIFIER_URL=

# --- keys (absolute paths to keystore files) ---
KEYSTORE_DIR=
DEPLOYER_KEY_FILE=
OPS_HEDERA_KEY_FILE=
OPS_ARB_KEY_FILE=
PRECHECK_SIGNER_KEY_FILE=
PLATFORM_KEY_FILE=
AGENT_KEY_FILE=
SHOP_KEY_FILE=
SCHEME_KEY_FILE=
BUYER_KEY_FILE=
FACILITATOR_KEY_FILE=

# --- parties and deployments (absolute paths) ---
# Comma-separated <role>=0.0.N pairs for deployer, ops-hedera, precheck-signer, platform, agent,
# shop, scheme, buyer, facilitator.
HEDERA_ACCOUNT_IDS=
DEPLOYMENTS_DIR=
PARTIES_FILE=
SUITE_LOCK_FILE=

# --- contracts: deploy inputs ---
RULING_RELAYER_ADDRESS=
PRECHECK_SIGNER_ADDRESS=
POOL_ADDRESS=
ANVIL_PORT_HEDERA=

# --- agent and shop ---
AGENT_SPEND_LIMIT_USDC=
AGENT_MAX_ORDER_USDC=
AGENT_DAILY_CAP_USDC=
AGENT_APPROVAL_TTL_SEC=
# usdc (the default) or hbar: the asset x402 orders are priced and paid in. Set it in the shared
# env file, not in a <service>.env, so the shop, the agent and ops/fund read the same value.
PRICE_ASSET=
SHOP_PUBLIC_URL=
SHOP_BASE_URL=
SHOP_PORT=
AGENT_PORT=
SHOP_STANDING_CHECK=

# --- precheck and keeper ---
PRECHECK_STATE_DIR=
PRECHECK_PORT=
KEEPER_STATE_DIR=
KEEPER_PORT=
KEEPER_REFILE_HOLD_MIN=
KEEPER_ARB_CONFIRMATIONS=
KEEPER_POLL_MS=
# Seconds a quiet record topic waits before a missing record counts as final (default 120).
PRECHECK_QUIET_S=
# Optional. Comma list of <chain>@<fromISO>/<toISO> spans with no sends, chain hedera or arbitrum,
# e.g. hedera@2026-11-06T17:45:00Z/2026-11-06T18:55:00Z
SEND_PAUSE_WINDOWS=

# --- docket and intake ---
DOCKET_PORT=
DOCKET_STATE_DIR=
DOCKET_STORE=
DOCKET_PUBLISH_THRESHOLD=
DOCKET_SAMPLE_MODE=
DOCKET_Z=
DOCKET_POLL_SECONDS=
DOCKET_RETRY_SECONDS=
DOCKET_RETRY_MAX=
ARKIV_LIFETIME_DAYS=
ARKIV_PAGE_SIZE=
ARKIV_MIN_TGLM=
SCHEME_MIN_HBAR=
REVIEWS_ENABLED=
REVIEW_VALUE_FAULT=
REVIEW_VALUE_CLEAR=
REVIEW_TAG1=
INTAKE_PORT=
INTAKE_CORS_ORIGIN=
INTAKE_MAX_BYTES=
INTAKE_RATE_PER_MIN=
INTAKE_LLM_TIMEOUT_MS=
INTAKE_LLM_PAUSE_MIN=

# --- status api ---
STATUS_API_PORT=
STATUS_API_STATE_DIR=
POLL_MS=
ARB_CONFIRMATIONS=
ARB_LOG_CHUNK=
SOURCE_TIMEOUT_MS=
VIEW_CACHE_MS=
LAG_WARN_S_HEDERA=
LAG_WARN_S_ARB=
LAG_WARN_S_HCS=
IPFS_RATE_PER_MIN=
DOCKET_URL=
INTAKE_URL=
AGENT_URL=
PRECHECK_URL=
WEB_ORIGIN=
# Court page link for a dispute; {id} is the dispute id
# (default https://v2-testnet.kleros.builders/#/cases/{id}/overview).
COURT_URL_TEMPLATE=

# --- web (public build-time values, baked into the bundle) ---
VITE_STATUS_API_URL=
VITE_ARKIV_PUBLIC_RPC_URL=
VITE_POLL_MS=
