{
  "name": "@recourse/shop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "test": "vitest run --passWithNoTests --exclude '**/*.anvil.test.ts'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:anvil": "vitest run --passWithNoTests anvil.test",
    "pack": "tsx scripts/pack.ts",
    "file-claim": "tsx scripts/file-claim.ts",
    "reconcile": "tsx scripts/reconcile.ts"
  },
  "dependencies": {
    "@hiero-ledger/sdk": "2.85.0",
    "@recourse/records": "workspace:*",
    "@recourse/shared": "workspace:*",
    "@x402/core": "2.28.0",
    "@x402/express": "2.28.0",
    "@x402/hedera": "2.28.0",
    "express": "5.3.0",
    "tsx": "4.23.15",
    "viem": "2.57.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.6"
  }
}
