{
  "name": "@recourse/keeper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "test": "vitest run --passWithNoTests --exclude \"test/anvil/**\"",
