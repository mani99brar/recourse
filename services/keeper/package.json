    "test:anvil": "vitest run --config vitest.anvil.config.ts"
  },
  "dependencies": {
    "@recourse/court": "workspace:*",
    "@recourse/records": "workspace:*",
    "@recourse/shared": "workspace:*",
    "express": "5.3.0",
    "tsx": "4.23.15",
    "viem": "2.57.8"
  },
  "devDependencies": {
    "@types/express": "5.0.6"
  }
}
